    "bcryptjs": "^2.4.3",
    "bullmq": "^5.41.0",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "nodemailer": "^6.10.1",
    "openai": "^4.85.4",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
