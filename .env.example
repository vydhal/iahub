# Configurações do Ambiente

# Servidor
PORT=3000
NODE_ENV=development
# Obrigatório — o docker-compose.yml recusa subir sem isso (sem valor padrão de propósito).
# Gere um valor forte e único por ambiente: openssl rand -base64 48
JWT_SECRET=

# Banco de Dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/aicreativestudio?schema=public"
# Usada só pelo docker-compose.prod.yml (produção) — senha real do Postgres, nunca "postgres".
POSTGRES_PASSWORD=

# Redis & BullMQ
REDIS_HOST=redis
REDIS_PORT=6379

# Provedores de IA
AI_MOCK_MODE=true
OPENAI_API_KEY=sk-dummy-openai-key
ANTHROPIC_API_KEY=sk-ant-dummy-anthropic-key

# Armazenamento (Storage Provider)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=http://localhost:3000/uploads
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=media-studio

# Agent Operations Center
# Obrigatório — o docker-compose.yml recusa subir sem isso. 32 bytes em hex: openssl rand -hex 32
CREDENTIALS_KEY=
# Worker de execução de agentes + agendador no mesmo processo da API
RUN_WORKERS=true
# true libera http/browser para redes privadas (localhost, 10.x, 192.168.x). Só em ambiente controlado.
ALLOW_PRIVATE_NETWORK=false
# URL pública da API — base dos links assinados do agendador e da notificação do Mercado Pago.
# Em produção, troque para o domínio real com HTTPS (ex: https://api.seudominio.com.br).
PUBLIC_API_URL=http://localhost:3000
